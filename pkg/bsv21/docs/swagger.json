    "definitions": {
        "bsv21.BalanceResponse": {
            "type": "object",
            "properties": {
                "balance": {
                    "type": "integer"
                },
                "utxoCount": {
                    "type": "integer"
                }
            }
        },
        "bsv21.ErrorResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        },
        "bsv21.OutputData": {
            "description": "Output or input data for a transaction",
            "type": "object",
            "properties": {
                "data": {
                    "type": "object",
                    "additionalProperties": {}
                },
                "spend": {
                    "description": "Spending txid hex (for outputs only, null if unspent)",
                    "type": "string"
                },
                "txid": {
                    "description": "Source txid (for inputs only)",
                    "type": "string"
                },
                "vout": {
                    "type": "integer"
                }
            }
        },
        "bsv21.TokenDetailResponse": {
            "description": "Combined token metadata and funding status",
            "type": "object",
            "properties": {
                "status": {
                    "$ref": "#/definitions/bsv21.TokenStatus"
                },
                "token": {
                    "$ref": "#/definitions/parse.BSV21"
                },
                "tokenId": {
                    "type": "string"
                }
            }
        },
        "bsv21.TokenStatus": {
            "type": "object",
            "properties": {
                "credits": {
                    "description": "Funding metrics (from DB on creation/recalc)",
                    "type": "integer"
                },
                "debits": {
                    "type": "integer"
                },
                "decimals": {
                    "type": "integer"
                },
                "fee_address": {
                    "type": "string"
                },
                "fee_per_output": {
                    "type": "integer"
                },
                "icon": {
                    "type": "string"
                },
                "is_blacklisted": {
                    "type": "boolean"
                },
                "is_whitelisted": {
                    "description": "List status",
                    "type": "boolean"
                },
                "output_count": {
                    "type": "integer"
                },
                "symbol": {
                    "description": "Token metadata",
                    "type": "string"
                },
                "token_id": {
                    "description": "Identity",
                    "type": "string"
                }
            }
        },
        "bsv21.TransactionData": {
            "description": "Transaction details with inputs, outputs, and optional BEEF",
            "type": "object",
            "properties": {
                "beef": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "inputs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/bsv21.OutputData"
                    }
                },
                "outputs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/bsv21.OutputData"
                    }
                },
                "txid": {
                    "type": "string"
                }
            }
        },
        "parse.BSV21": {
            "type": "object",
            "properties": {
                "amt": {
                    "type": "string",
                    "example": "0"
                },
                "dec": {
                    "type": "string",
                    "example": "0"
                },
                "icon": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "op": {
                    "type": "string"
                },
                "sym": {
                    "type": "string"
                }
            }
        },
        "txo.IndexedOutput": {
            "type": "object"
        },
        "txo.IndexedOutputResponse": {
            "description": "Transaction output with indexing metadata",
            "type": "object",
            "properties": {
                "blockHeight": {
                    "description": "Present if IncludeBlock",
                    "type": "integer"
                },
                "blockIdx": {
                    "description": "Present if IncludeBlock",
                    "type": "integer"
                },
                "data": {
                    "description": "Present if IncludeTags has entries",
                    "type": "object",
                    "additionalProperties": {}
                },
                "events": {
                    "description": "Present if IncludeEvents",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "outpoint": {
                    "description": "Always present: \"txid.vout\" format",
                    "type": "string"
                },
                "satoshis": {
                    "description": "Present if IncludeSats",
                    "type": "integer"
                },
                "score": {
                    "description": "Always present",
                    "type": "number"
                },
                "spend": {
                    "description": "Present if IncludeSpend (nil = unspent, string = spend txid)",
                    "type": "string"
                }
            }
        }
    }
}