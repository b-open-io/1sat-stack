                ],
                "summary": "List BSV21 topic managers",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/overlay/lookup": {
            "post": {
                "description": "Query the BSV21 overlay lookup service",
                "consumes": [
                    "application/json"
                ],
