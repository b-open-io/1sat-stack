                    "application/json"
                ],
                "tags": [
                    "bsv21-overlay"
                ],
                "summary": "BSV21 overlay lookup",
                "parameters": [
                    {
                        "description": "Lookup query",
                        "name": "query",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
