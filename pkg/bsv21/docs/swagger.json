{
    "swagger": "2.0",
    "info": {
        "description": "Transaction details with inputs, outputs, and optional BEEF",
        "contact": {}
    },
    "paths": {
        "/overlay/listLookupServiceProviders": {
            "get": {
                "description": "Returns BSV21 overlay lookup service providers",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "bsv21-overlay"
                ],
                "summary": "List BSV21 lookup services",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/overlay/listTopicManagers": {
            "get": {
                "description": "Returns BSV21 overlay topic managers",
                "produces": [
                    "application/json"
                ],
                "tags": [
