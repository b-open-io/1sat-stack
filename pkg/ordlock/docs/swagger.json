            "get": {
                "description": "Returns market overlay lookup service providers",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "market-overlay"
                ],
                "summary": "List market lookup services",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
