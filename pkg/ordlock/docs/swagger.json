                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "market-overlay"
                ],
                "summary": "Market overlay lookup",
                "parameters": [
                    {
                        "description": "Lookup query",
                        "name": "query",
                        "in": "body",
